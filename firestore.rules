rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isChatMember(chatId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    match /profiles/{profileUid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.uid == profileUid
        && profileUid == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.authUid == request.auth.uid
        && request.resource.data.authUid == request.auth.uid;
    }

    match /usernames/{usernameLower} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.username is string;
      allow update, delete: if signedIn()
        && resource.data.authUid == request.auth.uid
        && request.resource.data.authUid == request.auth.uid;
    }

    match /chats/{chatId} {
      allow get, list: if signedIn()
        && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastSenderUid', 'updatedAt'])
        && request.resource.data.lastSenderUid == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      match /messages/{messageId} {
        allow get, list: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}